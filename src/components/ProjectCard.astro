---
import { type CollectionEntry, getEntry } from "astro:content";
import LayerTags from "./LayerTags.astro";
import { STATUS_LABEL } from "@utils/getSortedProjects";

export interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h2" } = Astro.props;
const { title, summary, layers, cover, coverAlt, links, status, year, partOf } =
  project.data;
const href = `/work/${project.slug}/`;
const Heading = headingLevel;
const parent = partOf ? await getEntry("projects", partOf) : undefined;
const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<li class="project-card">
  <a href={href} class="cover" tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <img
          src={cover}
          alt={coverAlt ?? ""}
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
        />
      ) : (
        <span class="cover-placeholder">
          <span>{layers.join(" / ")}</span>
        </span>
      )
    }
  </a>
  <div class="body">
    <p class="meta">
      <span class={`status status-${status}`}>{STATUS_LABEL[status]}</span>
      {year && <span>· {year}</span>}
    </p>
    <Heading class="title">
      <a href={href}>{title}</a>
    </Heading>
    <LayerTags items={layers} />
    <p class="summary">{summary}</p>
    {
      parent && (
        <p class="part-of">
          Part of <a href={`/work/${parent.slug}/`}>{parent.data.title}</a>
        </p>
      )
    }
    {
      links.length > 0 && (
        <ul class="links">
          {links.map(link => (
            <li>
              <a
                href={link.url}
                target={isExternal(link.url) ? "_blank" : undefined}
                rel={isExternal(link.url) ? "noopener" : undefined}
              >
                {link.label}
                {isExternal(link.url) && " ↗"}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .project-card {
    @apply flex flex-col overflow-hidden rounded border border-skin-line;
  }
  .cover {
    @apply block aspect-video w-full overflow-hidden border-b border-skin-line;
  }
  .cover img {
    @apply h-full w-full object-cover;
  }
  .cover-placeholder {
    @apply flex h-full w-full items-center justify-center bg-skin-card bg-opacity-40 p-4 text-center text-xs uppercase tracking-widest;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 10px,
      rgba(var(--color-border), 0.18) 10px 11px
    );
  }
  .body {
    @apply flex flex-1 flex-col gap-2 p-4;
  }
  .meta {
    @apply flex gap-1 text-xs uppercase tracking-wide opacity-80;
  }
  .status-live::before {
    content: "● ";
    @apply text-skin-accent;
  }
  .title {
    @apply text-lg font-semibold leading-snug;
  }
  .title a {
    @apply decoration-dashed underline-offset-4 hover:text-skin-accent hover:underline;
  }
  .summary {
    @apply text-sm;
  }
  .part-of {
    @apply text-sm opacity-80;
  }
  .part-of a {
    @apply underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }
  .links {
    @apply mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-1 text-sm;
  }
  .links a {
    @apply underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }
</style>
